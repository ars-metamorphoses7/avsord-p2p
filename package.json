{
  "name": "jump-p2p",
  "version": "1.0.7",
  "private": true,
  "type": "module",
  "description": "JUMP — salas P2P com chat, áudio e compartilhamento de tela",
  "author": "JUMP",
  "repository": {
    "type": "git",
    "url": "https://github.com/ars-metamorphoses7/avsord-p2p.git"
  },
  "main": "electron/main.cjs",
  "desktopName": "com.jumpnetwork.app",
  "build": {
    "appId": "com.jumpnetwork.app",
    "productName": "JUMP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server.mjs",
      "package.json",
      "src/assets/**/*"
    ],
    "artifactName": "JUMP-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "JUMP invite",
        "schemes": [
          "jump"
        ]
      }
    ],
    "win": {
      "icon": "src/assets/win98/jump-app-icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "src/assets/win98/jump-app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "synopsis": "Salas P2P com áudio, tela e chat",
      "description": "Salas ponto a ponto com áudio, compartilhamento de tela e mensagens sem servidor central.",
      "maintainer": "JUMP <jump@localhost>"
    },
    "publish": {
      "provider": "github",
      "owner": "ars-metamorphoses7",
      "repo": "avsord-p2p",
      "releaseType": "release"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"node server.mjs\" \"vite\"",
    "build": "vite build",
    "desktop": "electron .",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:build:win": "npm run build && electron-builder --win nsis",
    "desktop:build:linux": "npm run build && electron-builder --linux AppImage deb",
    "desktop:build": "npm run desktop:build:win",
    "start": "node server.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron-updater": "^6.8.9",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  }
}
